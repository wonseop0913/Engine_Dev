<AnimationEvents>
    <Animation Name="idle">
        <Custom CustomEvent="Step" Tick="33.3"/>
        <Custom CustomEvent="Step" Tick="60.5"/>
        <End    Tick="97.5"/>
    </Animation>

    <Animation Name="walk_forward">
        <Custom CustomEvent="Step" Tick="10.8"/>
        <Custom CustomEvent="Step" Tick="70.3"/>
    </Animation>

    <Animation Name="attack1">
        <Custom CustomEvent="RotateToTarget" Tick="0.0" Flag="true"/>
        <Custom CustomEvent="Step" Tick="18.6"/>
        <Custom CustomEvent="Sound" Tick="35.2" SoundName="ZombieAttackNoise"/>
        <Custom CustomEvent="RotateToTarget" Tick="37.2" Flag="false"/>
        <Custom CustomEvent="Sound" Tick="37.2" SoundName="ZombieAttack"/>
        <Custom CustomEvent="Attack" Tick="37.8" Damage="5.0" MeleeWeaponActivation="true"/>
        <Custom CustomEvent="Attack" Tick="41.0" MeleeWeaponActivation="false"/>
        <Custom CustomEvent="Step" Tick="41.0"/>
        <End    Tick="79.5"/>
    </Animation>

    <Animation Name="reaction_hit" Start="8.0">
        <Speed Tick="8.0" Speed="1.8"/>
    </Animation>

    <Animation Name="scream">
        <Custom CustomEvent="RotateToTarget" Tick="0.0" Flag="true"/>
        <Custom CustomEvent="RotateToTarget" Tick="27.7" Flag="false"/>
        <Custom CustomEvent="Sound" Tick="27.7" SoundName="ZombieScream"/>
    </Animation>

    <Animation Name="death">
        <Custom CustomEvent="Sound" Tick="0.0" SoundName="ZombieDeath"/>
        <Custom CustomEvent="Step" Tick="32.1"/>
        <Custom CustomEvent="Step" Tick="66.7"/>
        <Custom CustomEvent="Sound" Tick="66.7" SoundName="ZombieDeathEnd"/>
    </Animation>
</AnimationEvents>